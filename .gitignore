# Configuracao com credenciais. Use .env.example como modelo.
.env
.env.coolify
.env.local

# composer.lock FICA versionado de proposito: e ele que garante que o
# "composer install" do Dockerfile instale exatamente as mesmas versoes.
#
# vendor/ continua versionado (ja estava) porque e o que permite subir o jogo
# por FTP em hospedagem compartilhada, onde nao ha SSH para rodar o Composer.
# Novos arquivos dentro de vendor/ ainda entram com "git add -f".

# Estado gerado em runtime.
_cache/
uploads/
reports/*.txt
*.log
php_error.log

# Ambiente local
wamp64/
.DS_Store
Thumbs.db
.vscode/
.idea/
