# =============================================================================
#  Naruto MMORPG - modelo de configuracao
# =============================================================================
#  Copie para .env e preencha, OU deixe o instalador web (/install/) gerar
#  este arquivo para voce.
#
#  Em Docker/Coolify voce normalmente NAO usa este arquivo: cada chave vira
#  uma variavel de ambiente no painel. O codigo le os dois caminhos.
#
#  NUNCA versione o .env preenchido.
# =============================================================================

# --- Banco de dados ---------------------------------------------------------
# Em docker-compose o host e o nome do servico do banco: db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=naruto
DB_USER=root
DB_PASS=

# --- Identidade do jogo -----------------------------------------------------
# Aparece no titulo das paginas e nas mensagens do jogo.
GAME_NAME=Fight
NARUTO_NOME=Fight

# --- Comportamento da aplicacao ---------------------------------------------
# APP_DEBUG=true mostra erros na tela. Mantenha false em producao: warnings
# do PHP vazam caminho do servidor e trechos de query.
APP_DEBUG=false

# Fuso usado por todos os timers (missao, treino, VIP, penalidade).
APP_TIMEZONE=America/Sao_Paulo

# O schema de 2013 grava datas '0000-00-00', recusadas pelo modo estrito do
# MySQL 8 / MariaDB 10.5+. Deixe true ate o schema ser modernizado.
DB_LEGACY_SQL_MODE=true

# --- Instalador -------------------------------------------------------------
# Deixe true so ate terminar de instalar; depois troque para false (ou apague
# a pasta install/ do servidor).
INSTALLER_ENABLED=true

# Senha de acesso ao instalador. Depois que o jogo esta instalado, o
# instalador se fecha sozinho ao detectar as tabelas no banco, e este token
# passa a ser o unico jeito de reabri-lo: /install/?token=SEU_TOKEN
INSTALL_TOKEN=

# --- E-mail (recuperacao de senha, via PHPMailer) ---------------------------
MAIL_FROM_NAME="Naruto RPG"
MAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
# tls, ssl, ou vazio para sem criptografia
SMTP_SECURE=tls

# --- Cloudflare Turnstile (captcha do cadastro) -----------------------------
# Vazio = captcha desligado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Notificacao de erros (opcional) ----------------------------------------
# Webhook do Discord que recebe os erros de PHP em producao.
DISCORD_WEBHOOK_URL=
